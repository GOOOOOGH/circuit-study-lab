    "moduleId": "D04"
  },
  {
    "id": "TERM024",
    "term": "亚稳态",
    "definition": "触发器违规采样后可能延长解析时间，同步降低传播概率但不归零。",
    "moduleId": "D04"
  },
  {
    "id": "TERM025",
