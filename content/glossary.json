    "moduleId": "F02"
  },
  {
    "id": "TERM003",
    "term": "RMS",
    "definition": "均方根用于同电阻平均功率等效，非任意波形峰值除√2。",
    "moduleId": "F03"
  },
  {
    "id": "TERM004",
    "term": "相量",
    "definition": "同频正弦的复幅表示，需固定峰值或RMS、参考和eʲωt约定。",
