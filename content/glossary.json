  },
  {
    "id": "TERM005",
    "term": "Q点",
    "definition": "器件直流工作点，小信号模型在其附近线性化。",
    "moduleId": "A02"
  },
  {
    "id": "TERM006",
    "term": "gm",
    "definition": "跨导：局部输出电流对输入控制电压导数，单位S。",
