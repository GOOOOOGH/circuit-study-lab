  },
  {
    "id": "TERM007",
    "term": "rπ",
    "definition": "BJT基极输入小信号电阻，近似β/gm。",
    "moduleId": "A02"
  },
  {
    "id": "TERM008",
    "term": "VGS(th)",
    "definition": "MOS阈值按规定小电流测试，不保证目标RDS(on)。",
    "moduleId": "A01"
  },
  {
    "id": "TERM009",
    "term": "SOA",
    "definition": "安全工作区，需同时给电压、电流、脉宽、温度和重复条件。",
    "moduleId": "E03"
  },
  {
    "id": "TERM010",
    "term": "CMRR",
    "definition": "共模抑制比，差模/共模增益之比，随频率及条件变化。",
    "moduleId": "A03"
  },
  {
    "id": "TERM011",
    "term": "PSRR",
    "definition": "电源扰动到输出/输入等效误差的抑制能力，定义和频率需查手册。",
    "moduleId": "A09"
  },
  {
    "id": "TERM012",
    "term": "GBW",
    "definition": "增益带宽积；单主极点近似有效，不代替压摆率和稳定性。",
    "moduleId": "E04"
  },
  {
    "id": "TERM013",
    "term": "SR",
    "definition": "压摆率，输出最大电压变化速度；满幅高速正弦需检查。",
    "moduleId": "E04"
  },
  {
    "id": "TERM014",
    "term": "噪声增益",
    "definition": "运放输入等效误差/噪声到输出的增益，与信号增益可不同。",
    "moduleId": "A06"
  },
  {
    "id": "TERM015",
    "term": "米勒效应",
    "definition": "跨输入输出电容在反相增益下可能放大输入等效电容。",
    "moduleId": "A04"
  },
  {
    "id": "TERM016",
    "term": "相位裕量",
    "definition": "给定负反馈环路在增益交越的相位距临界值的量。",
    "moduleId": "A05"
  },
  {
    "id": "TERM017",
    "term": "迟滞",
    "definition": "随当前状态不同采用两个切换阈值。",
    "moduleId": "A07"
  },
  {
    "id": "TERM018",
    "term": "交越失真",
    "definition": "推挽两支路在转换附近非理想导通造成的失真。",
    "moduleId": "A08"
  },
  {
    "id": "TERM019",
    "term": "补码",
    "definition": "有限位有符号编码，最高位负权；溢出与无符号进位不同。",
    "moduleId": "D01"
  },
  {
    "id": "TERM020",
    "term": "卡诺图",
    "definition": "按格雷邻接分组化简逻辑，边界可回绕。",
    "moduleId": "D01"
  },
  {
    "id": "TERM021",
    "term": "开漏",
    "definition": "输出只能主动拉低，需外部上拉形成高态。",
    "moduleId": "D02"
  },
  {
    "id": "TERM022",
    "term": "扇出",
    "definition": "输出可驱动输入负载能力，静态电流和动态电容均要核。",
    "moduleId": "D02"
  },
  {
